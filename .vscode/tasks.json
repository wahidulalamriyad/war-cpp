{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: build (debug)",
            "detail": "clang++ all .cpp in the current project folder -> bin/debug/<project>",
            "type": "shell",
            "command": "mkdir -p bin/debug && clang++ -std=c++20 -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Wsign-conversion -Werror -fcolor-diagnostics -fansi-escape-codes -g -O0 *.cpp -o \"bin/debug/${fileDirnameBasename}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${fileDirname}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "C/C++: build (release)",
            "detail": "Optimised, no debug info -> bin/release/<project>",
            "type": "shell",
            "command": "mkdir -p bin/release && clang++ -std=c++20 -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Wsign-conversion -Werror -fcolor-diagnostics -fansi-escape-codes -O2 -DNDEBUG *.cpp -o \"bin/release/${fileDirnameBasename}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${fileDirname}"
                ]
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "C/C++: build & run (debug)",
            "detail": "Builds, then runs in the integrated terminal so std::cin works",
            "type": "shell",
            "command": "\"./bin/debug/${fileDirnameBasename}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "C/C++: build (debug)",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "C/C++: build & run (release)",
            "detail": "Use this one when timing your code",
            "type": "shell",
            "command": "\"./bin/release/${fileDirnameBasename}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "C/C++: build (release)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-pedantic-errors",
                "-Wall",
                "-Weffc++",
                "-Wextra",
                "-Wconversion",
                "-Wsign-conversion"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}